{
  "name": "atelier",
  "productName": "Atelier",
  "version": "0.1.0",
  "private": true,
  "description": "Atelier: an AI agent team and a video engine that reverse-engineers a channel's production pipeline.",
  "author": "Charlie Jourdan",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:cloud && npm run typecheck:engine && npm run typecheck:site",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:cloud": "tsc --noEmit -p cloud/tsconfig.json",
    "typecheck:engine": "tsc --noEmit -p tsconfig.engine.json",
    "typecheck:site": "tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "schemas": "node scripts/gen-schemas.mjs",
    "test:e2e": "npm run build && playwright test",
    "smoke:agent": "npm run build && vitest run -c vitest.smoke.config.mts scripts/smoke-agent.ts",
    "dist": "npm run build && electron-builder --config electron-builder.config.mjs --win nsis dir",
    "dist:mac": "npm run build && electron-builder --config electron-builder.mac.config.mjs --mac --arm64",
    "release": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-transpile.mjs scripts/release.ts",
    "test:packaged": "playwright test -c playwright.packaged.config.ts",
    "cloud:dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cloud/src/main.ts",
    "cloud": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON cloud/src/cli.ts",
    "smoke:cloud": "vitest run -c vitest.smoke.config.mts scripts/smoke-cloud.ts",
    "pipelines:soak": "vitest run -c vitest.soak.config.mts",
    "engine:demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-resolve.mjs scripts/engine-demo.ts",
    "engine:story-demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-resolve.mjs scripts/engine-story-demo.ts",
    "engine:reddit-demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-resolve.mjs scripts/engine-reddit-demo.ts",
    "engine:dialogue-demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-resolve.mjs scripts/engine-dialogue-demo.ts",
    "engine:avatar-demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-resolve.mjs scripts/engine-avatar-demo.ts",
    "engine:avatar-base-demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-resolve.mjs scripts/engine-avatar-base-demo.ts",
    "engine:style-demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-resolve.mjs scripts/engine-style-demo.ts",
    "media:proof": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-resolve.mjs scripts/media-proof.ts",
    "previews:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-resolve.mjs scripts/previews-seed.ts",
    "previews:options": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-resolve.mjs scripts/option-previews-seed.ts",
    "engine:documentary2-demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-resolve.mjs scripts/engine-documentary2-demo.ts",
    "engine:motion-demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-resolve.mjs scripts/engine-motion-demo.ts",
    "engine:motion-studio-demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-resolve.mjs scripts/motion-studio-demo.ts",
    "engine:motion-kit-demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-resolve.mjs scripts/engine-motion-kit-demo.ts",
    "engine:map3d-demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-resolve.mjs scripts/map3d-demo.ts",
    "engine:brick-demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-resolve.mjs scripts/engine-brick-demo.ts",
    "engine:promo-demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-resolve.mjs scripts/engine-promo-demo.ts",
    "web:app": "vite build -c vite.web.config.ts",
    "web:app:dev": "vite -c vite.web.config.ts",
    "brain:headless": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-transpile.mjs src/main/headless/main.ts",
    "brain:keeper": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-transpile.mjs src/main/headless/keeper-main.ts",
    "team-pc:drill": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-transpile.mjs scripts/team-pc-drill.ts",
    "orchestra:demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-transpile.mjs scripts/orchestra-demo.ts",
    "orchestra:week": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/ts-transpile.mjs scripts/orchestra-week.ts",
    "site:dev": "vite -c vite.site.config.ts",
    "site:build": "npm run web:app && vite build -c vite.site.config.ts && node web/scripts/copy-app.mjs",
    "demo:web": "vite -c vite.demo.config.ts",
    "demo:web:build": "vite build -c vite.demo.config.ts && node scripts/demo-web-index.mjs && vite build -c vite.site-demo.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@react-three/fiber": "9.8.2",
    "@tailwindcss/vite": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "electron-updater": "6.8.11",
    "lucide-react": "1.59.0",
    "maplibre-gl": "6.14.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "use-stick-to-bottom": "1.1.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "fastify": "5.12.7",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
