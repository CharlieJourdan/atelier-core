# Atelier — variables d'environnement (noms seulement, AUCUNE valeur).
# Les clés des fournisseurs ne vont PAS ici : elles vont dans le coffre chiffré du Cloud
#   npm run cloud -- vault set NOM        (liste des noms : docs/TECHNOS.md)
# Ce fichier liste ce que le code lit dans process.env. Rien n'est obligatoire pour `npm test` ni `npm run cloud:dev`.

# --- Atelier Cloud (cloud/) ---
ATELIER_CLOUD_DATA=                    # dossier de données du Cloud (défaut ~/.atelier-cloud ; JAMAIS dans le dépôt ; chemin court)
ATELIER_CLOUD_PORT=                    # remplace le port de config.json (défaut 8787)
ATELIER_CLOUD_MAX_JOBS=                # jobs simultanés (1-64, défaut 8)
ATELIER_CLOUD_MAX_JOBS_PER_PROVIDER=   # jobs simultanés par fournisseur (1-64, défaut 4)
ATELIER_CLOUD_MASTER_KEY_FILE=         # chemin absolu de la clé maître du coffre (créée par `npm run cloud -- key init <chemin>`) ; sans elle, pas de fournisseur réel
ATELIER_CLOUD_KEYCHAIN=                # "1" sur macOS : clé maître lue dans le Trousseau
ATELIER_CLOUD_LOG=                     # niveau de log (défaut info)
ATELIER_CLOUD_TEST=                    # "1" = run de test : jamais d'adaptateur réel
ATELIER_ADMIN_TOKEN=                   # jeton admin plateforme (affiché par `npm run cloud -- admin token`), lu par scripts/release.ts
ATELIER_ENROL_TOKEN=                   # jeton d'inscription d'un ordinateur d'équipe
ATELIER_CLOUD_SMOKE_PORT=              # port du Cloud lancé par `npm run smoke:cloud`

# --- App / cerveau (src/main) ---
ATELIER_CLOUD_URL=                     # adresse du Cloud pour l'app et les ordinateurs d'équipe (défaut http://127.0.0.1:8787)
ATELIER_BETA_CLOUD=                    # adresse du Cloud figée à la compilation (`npm run dist`)
ATELIER_USER_DATA=                     # dossier de données de l'app (mettre un dossier de dev pour `npm run dev`)
ATELIER_UPDATES=                       # "off" = pas de mise à jour automatique
ATELIER_GOOGLE=                        # "off" = pas de rafraîchissement YouTube/Google quotidien
ATELIER_GOOGLE_CLIENT_ID=              # client OAuth Google (YouTube Analytics, lecture seule) ; sinon collé dans Réglages
ATELIER_GOOGLE_CLIENT_SECRET=
ATELIER_FAKE_LLM=                      # "1" = LLM et Discord factices (tests e2e)
ATELIER_RUNNER=                        # "off" = agents inactifs
ATELIER_AUTOMATIONS=                   # "off" = pas d'automatisations
ATELIER_EXAMPLE=                       # "1" = charge l'espace d'exemple au premier lancement
ATELIER_PIPELINE_DEV=                  # "1" = drapeaux d'édition manuelle des pipelines

# --- Moteur et outils locaux (src/engine) ---
ATELIER_WHISPER_PYTHON=                # Python avec faster-whisper et OpenCV (minutage des mots, identité du présentateur)
ATELIER_WHISPER_MODEL=                 # modèle sur GPU (défaut large-v3)
ATELIER_WHISPER_CPU_MODEL=             # modèle sur CPU (défaut small)
ATELIER_CHROMIUM=                      # chemin d'un Chromium/Chrome pour le rendu motion (sinon celui de Playwright)
PLAYWRIGHT_BROWSERS_PATH=              # cache des navigateurs Playwright
ATELIER_BROWSER_GPU=                   # "1" = GPU pour le navigateur de rendu

# --- Scripts de démo ---
ATELIER_INPUTS=                        # dossier des entrées/sorties des démos (défaut : un dossier sous le dossier temporaire)
FREESOUND_API_KEY=                     # seule clé lue en env : scripts/sfx-library-fetch.ts (remplir la banque d'effets)

# --- Déploiement (deploy/cloud, service litestream) ---
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
